headers = openssl/ssl.h openssl/err.h openssl/bio.h openssl/pem.h openssl/pkcs12.h
headerFilter = openssl/*
package = openssl
staticLibraries = libssl.a libcrypto.a

# Paths below are relative to the repository root and point at the output
# layout produced by scripts/build-openssl-apple.sh (which wraps
# https://github.com/x2on/OpenSSL-for-iPhone). Run that script before
# invoking cinterop/regenerating the openssl-*.klib files in
# kmqtt-common/src/nativeInterop. Do not hardcode a personal machine path
# here again - it breaks the build for every other contributor/CI runner.

compilerOpts.macos_x64 = -I../openssl-apple/mac-x64/include
libraryPaths.macos_x64 = ../openssl-apple/mac-x64

compilerOpts.macos_arm64 = -I../openssl-apple/mac-arm64/include
libraryPaths.macos_arm64 = ../openssl-apple/mac-arm64

compilerOpts.ios_x64 = -I../openssl-apple/bin/iPhoneSimulator-x86_64.sdk/include
libraryPaths.ios_x64 = ../openssl-apple/bin/iPhoneSimulator-x86_64.sdk/lib

compilerOpts.ios_simulator_arm64 = -I../openssl-apple/bin/iPhoneSimulator-arm64.sdk/include
libraryPaths.ios_simulator_arm64 = ../openssl-apple/bin/iPhoneSimulator-arm64.sdk/lib

compilerOpts.ios_arm64 = -I../openssl-apple/bin/iPhoneOS-arm64.sdk/include
libraryPaths.ios_arm64 = ../openssl-apple/bin/iPhoneOS-arm64.sdk/lib

compilerOpts.tvos_x64 = -I../openssl-apple/bin/AppleTVSimulator-x86_64.sdk/include
libraryPaths.tvos_x64 = ../openssl-apple/bin/AppleTVSimulator-x86_64.sdk/lib

compilerOpts.tvos_simulator_arm64 = -I../openssl-apple/bin/AppleTVSimulator-arm64.sdk/include
libraryPaths.tvos_simulator_arm64 = ../openssl-apple/bin/AppleTVSimulator-arm64.sdk/lib

compilerOpts.tvos_arm64 = -I../openssl-apple/bin/AppleTVOS-arm64.sdk/include
libraryPaths.tvos_arm64 = ../openssl-apple/bin/AppleTVOS-arm64.sdk/lib

compilerOpts.watchos_x64 = -I../openssl-apple/bin/WatchSimulator-x86_64.sdk/include
libraryPaths.watchos_x64 = ../openssl-apple/bin/WatchSimulator-x86_64.sdk/lib

compilerOpts.watchos_simulator_arm64 = -I../openssl-apple/bin/WatchSimulator-arm64.sdk/include
libraryPaths.watchos_simulator_arm64 = ../openssl-apple/bin/WatchSimulator-arm64.sdk/lib

compilerOpts.watchos_arm64 = -I../openssl-apple/bin/WatchOS-arm64_32.sdk/include
libraryPaths.watchos_arm64 = ../openssl-apple/bin/WatchOS-arm64_32.sdk/lib

compilerOpts.watchos_arm32 = -I../openssl-apple/bin/WatchOS-armv7k.sdk/include
libraryPaths.watchos_arm32 = ../openssl-apple/bin/WatchOS-armv7k.sdk/lib
